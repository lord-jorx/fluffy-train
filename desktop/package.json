{
  "name": "war-table-desktop",
  "productName": "War Table",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop build of War Table (Windows, macOS, Linux).",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.wartable.claude",
    "productName": "War Table",
    "directories": { "output": "dist" },
    "files": ["main.cjs"],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "server.js",
          "lib/**",
          "public/**",
          "package.json",
          "node_modules/**",
          "!desktop/**",
          "!**/*.map"
        ]
      }
    ],
    "win": { "target": "nsis", "icon": "../public/icon-512.png" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity", "icon": "../public/icon-512.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility", "icon": "../public/icon-512.png" }
  }
}
