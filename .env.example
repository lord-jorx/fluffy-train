# --- IA (Dungeon Master) ---
# Clave del servidor: la usan los jugadores con suscripción (modelo Haiku forzado).
ANTHROPIC_API_KEY=sk-ant-...
PORT=3000

# --- Suscripción / monetización ---
# Nº de acciones gratis antes del paywall (por usuario).
TRIAL_ACTIONS=15

# ID del producto de suscripción creado en Google Play Console.
SUB_PRODUCT_ID=taberna_premium_monthly

# Nombre del paquete de la app (debe coincidir con capacitor.config.json).
PLAY_PACKAGE_NAME=com.tabernadel.dragon

# Ruta al JSON de la cuenta de servicio de Google (para verificar compras).
# Crea una cuenta de servicio en Google Cloud y dale acceso en Play Console.
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json

# Modo desarrollo de facturación: concede suscripción sin contactar con Google.
# ÚSALO SOLO EN LOCAL PARA PROBAR. En producción déjalo en false o sin definir.
DEV_BILLING=false
